# .dockerignore file for optimal Docker builds

# Node.js dependencies
node_modules/

# PHP Composer dependencies
vendor/

# Environment and secrets
.env
.env.*
*.pem
*.key
*.crt

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# Build and output directories
dist/
build/
out/

# Test and debug files
tests/
*.log

# Version control
.git/
.gitignore

# Temporary and local files
tmp/
temp/
*.tmp
.local/

# Documentation and examples
docs/
*.md
README*

# Docker-specific files
Dockerfile*
docker-compose*

# Exclude everything else
**/*

# Include necessary files
!app/
!bootstrap/
!config/
!database/
!public/
!resources/
!routes/
!storage/
!tests/
!artisan
!composer.json
!composer.lock
!package.json
!package-lock.json
!phpunit.xml

# End of .dockerignore file